{
  "compilerOptions": {
    "outDir": "./built",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "target": "ESnext",
    "module": "ESnext",
    "rootDir": ".",
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "paths": {
      "output/*": ["./output/*"],
      "data/*": ["./data/*"]
    }
  }
}
